---
interface Props {
    title?: string;
    description: string;
    tasks: string[];
}

const { title = "Practice activity", description, tasks } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<section
    class="my-8 rounded-xl border border-blue-200 bg-blue-50/60 p-5 sm:p-6"
    aria-labelledby="practice-activity-title"
>
    <div class="flex items-start gap-3">
        <div class="min-w-0 flex-1">
            <div class="flex items-center">
                <div
                    class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-700"
                    aria-hidden="true"
                >
                    <svg class="size-6 text-blue-600 justify-center">
                        <use href={`${baseUrl}/icons/icons.svg#light`}></use>
                    </svg>
                </div>
                <p
                    id="practice-activity-title"
                    class="ms-3 text-xl font-bold text-slate-900"
                >
                    {title}
                </p>
            </div>

            <p class="mt-2 leading-7 text-slate-700">{description}</p>

            <h3 class="mt-5 text-sm font-semibold uppercase tracking-wide text-slate-600">
                Complete the following tasks
            </h3>

            <ol class="mt-3 list-decimal space-y-2 pl-5 leading-7 text-slate-700 marker:font-medium marker:text-blue-700">
                {tasks.map((task) => (
                    <li>{task}</li>
                ))}
            </ol>
        </div>
    </div>
</section>
