---
const operatingSystems = [
  {
    id: "windows",
    label: "Windows",
    guide: "https://code.visualstudio.com/docs/setup/windows",
    steps: [
      "Open the official VS Code download page.",
      "Download and run the Windows installer.",
      "Follow the installation wizard.",
    ],
    commands: [],
    check: [],
  },
  {
    id: "linux",
    label: "Linux",
    guide: "https://code.visualstudio.com/docs/setup/linux",
    steps: [
      "Choose the instructions for your Linux distribution.",
      "Install VS Code using the appropriate package manager.",
    ],
    commands: [
      {
        label: "Ubuntu / Debian",
        language: "bash",
        code: "sudo apt update\nsudo apt install code",
      },
      {
        label: "Fedora / RHEL",
        language: "bash",
        code: "sudo dnf install code",
      },
    ],
    check: [
      {
        label: "Linux",
        language: "bash",
        code: "code --version"
      }
    ]
  },
];
---

<section
  class="rounded-xl border border-slate-200 bg-white p-3 sm:p-5"
  data-os-installer
>
  <h2 class="mt-2 text-2xl font-bold">Install Visual Studio Code</h2>
  <p class="mt-2 text-slate-600">
    Choose your operating system to see the installation instructions.
  </p>

  <div
    class="mt-6 flex flex-wrap gap-2"
    role="group"
    aria-label="Choose your operating system"
  >
    {operatingSystems.map((os) => (
      <button
        type="button"
        data-os-choice={os.id}
        aria-pressed="false"
        class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-100 aria-pressed:border-blue-600 aria-pressed:bg-blue-50 aria-pressed:text-blue-700"
      >
        {os.label}
      </button>
    ))}
  </div>

  <div class="mt-6">
    {operatingSystems.map((os) => (
      <div data-os-panel={os.id} hidden>
        <h3 class="text-lg font-semibold">
          Install on {os.label}
        </h3>

        <ol class="mt-3 list-decimal space-y-2 pl-5 text-slate-700">
          {os.steps.map((step) => <li>{step}</li>)}
        </ol>

        {os.commands.length > 0 && (
          <div class="mt-5 space-y-4">
            {os.commands.map((command) => (
              <section>
                <h4 class="mb-2 font-medium">{command.label}</h4>

                <div class="overflow-hidden rounded-lg bg-slate-900">
                  <div class="flex items-center justify-between border-b border-slate-700 px-4 py-2">
                    <span class="text-xs text-slate-400">
                      {command.language}
                    </span>

                    <button
                      type="button"
                      data-copy={command.code}
                      class="text-xs text-slate-300 hover:text-white"
                    >
                      Copy
                    </button>
                  </div>

                  <pre class="overflow-x-auto p-4 text-sm text-slate-100"><code>{command.code}</code></pre>
                </div>
              </section>
            ))}
          </div>
        )}

        {os.check.length > 0 && (
          
          <div class="mt-5 space-y-4">
            <p>To check if VSCode was correctly installed use:</p>
            {os.check.map((command) => (
              <section>
                <h4 class="mb-2 font-medium">{command.label}</h4>

                <div class="overflow-hidden rounded-lg bg-slate-900">
                  <div class="flex items-center justify-between border-b border-slate-700 px-4 py-2">
                    <span class="text-xs text-slate-400">
                      {command.language}
                    </span>

                    <button
                      type="button"
                      data-copy={command.code}
                      class="text-xs text-slate-300 hover:text-white"
                    >
                      Copy
                    </button>
                  </div>

                  <pre class="overflow-x-auto p-4 text-sm text-slate-100"><code>{command.code}</code></pre>
                </div>
              </section>
            ))}
          </div>
        )}

        <a
          href={os.guide}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-block font-semibold text-blue-600 hover:text-blue-700"
        >
          View official {os.label} installation guide
        </a>
      </div>
    ))}
  </div>
</section>

<section class="mt-5 rounded-xl border border-slate-200 bg-white p-3 sm:p-5">
  <a
    href="https://code.visualstudio.com/download"
    target="_blank"
    rel="noopener noreferrer"
    class="mt-6 inline-flex rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700"
  >
  Looking for more options? Visit the official website.
  </a>
</section>

<script>
  const installers = document.querySelectorAll("[data-os-installer]");

  installers.forEach((installer) => {
    const buttons = installer.querySelectorAll<HTMLButtonElement>(
      "[data-os-choice]"
    );
    const panels = installer.querySelectorAll<HTMLElement>(
      "[data-os-panel]"
    );

    function selectOS(os: string, updateURL = true) {
      const validOS = ["windows", "linux"];

      if (!validOS.includes(os)) return;

      buttons.forEach((button) => {
        const selected = button.dataset.osChoice === os;
        button.setAttribute("aria-pressed", String(selected));
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.osPanel !== os;
      });

      if (updateURL) {
        const url = new URL(window.location.href);
        url.searchParams.set("os", os);
        window.history.replaceState({}, "", url);
      }
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const os = button.dataset.osChoice;
        if (os) selectOS(os);
      });
    });

    installer
      .querySelectorAll<HTMLButtonElement>("[data-copy]")
      .forEach((button) => {
        button.addEventListener("click", async () => {
          const code = button.dataset.copy;
          if (!code) return;

          try {
            await navigator.clipboard.writeText(code);
            button.textContent = "Copied!";
          } catch (error) {
            console.error("Could not copy command:", error);
            button.textContent = "Copy failed";
          }

          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 2000);
        });
      });

    const requestedOS = new URLSearchParams(
      window.location.search
    ).get("os");

    const initialOS = Array.from(buttons).some(
      (button) => button.dataset.osChoice === requestedOS
    )
      ? requestedOS!
      : "windows";

    selectOS(initialOS, false);
  });
</script>
