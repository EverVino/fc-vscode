---
import { siteConfig } from "../config/site";
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
    <nav
        class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 lg:px-8"
        aria-label="Main navigation"
    >
        <!-- Brand -->
        <div class="flex gap-8">
            <a
                href="/"
                class="flex items-center gap-3"
                aria-label=`${ siteConfig.name } home`
            >
                <!-- FreeCampus mark -->
                <svg class="size-8">
                    <use href="/icons/icons.svg#freecampus"/>
                </svg>
                <div class="hidden sm:block font-bold text-2xl">
                    <span class="tracking-tight text-slate-900">
                        { siteConfig.name }
                    </span>
                    <span class="ml-1 text-slate-600">{ siteConfig.course }</span>
                </div>
            </a>
            <!-- Desktop navigation -->
            <div class="hidden items-center gap-1 md:flex text-xl">
                <a
                    href="/"
                    class="rounded-md px-3 py-2 font-medium
                   text-slate-900 hover:bg-slate-100"
                >
                    Home
                </a>
                <a
                    href="/units/"
                    class="rounded-md px-3 py-2 font-medium
                   text-slate-600 hover:bg-slate-100 hover:text-slate-900"
                >
                    Units
                </a>
                <a
                    href="/faq/"
                    class="rounded-md px-3 py-2 font-medium
                   text-slate-600 hover:bg-slate-100 hover:text-slate-900"
                >
                    FAQ
                </a>
                <a
                    href="/about/"
                    class="rounded-md px-3 py-2 font-medium
                   text-slate-600 hover:bg-slate-100 hover:text-slate-900"
                >
                    About
                </a>
            </div>
        </div>

        <!-- Right side -->
        <div class="hidden items-center gap-3 md:flex">
            <!-- GitHub -->
            <a
                href={ siteConfig.github }
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md p-2 text-slate-500
               hover:bg-slate-100 hover:text-slate-900"
                aria-label="FreeCampus on GitHub"
            >
            <svg class="size-8">
                <use href="/icons/icons.svg#github"/>
            </svg>

            </a>

            <!-- Start course -->
            <a
                href="/vscode/units/01-installation/"
                class="rounded-lg bg-blue-600 px-4 py-2 text-sm
               font-semibold text-white shadow-sm
               hover:bg-blue-700"
            >
                Start learning
            </a>
        </div>

        <!-- Mobile menu button -->
        <button
            type="button"
            class="rounded-md p-2 text-slate-600 hover:bg-slate-100
             hover:text-slate-900 md:hidden"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <svg
                class="h-6 w-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 6h16M4 12h16M4 18h16"
                />
            </svg>
        </button>
    </nav>

    <!-- Mobile navigation -->
    <div
        id="mobile-menu"
        class="hidden border-t border-slate-200 bg-white md:hidden"
    >
        <div class="space-y-1 px-6 py-4">
            <a
                href="/vscode/"
                class="block rounded-md px-3 py-2 text-sm font-medium
               text-slate-900 hover:bg-slate-100"
            >
                Course
            </a>

            <a
                href="/vscode/units/"
                class="block rounded-md px-3 py-2 text-sm font-medium
               text-slate-600 hover:bg-slate-100"
            >
                Units
            </a>

            <a
                href="/vscode/about/"
                class="block rounded-md px-3 py-2 text-sm font-medium
               text-slate-600 hover:bg-slate-100"
            >
                About
            </a>

            <a
                href="/vscode/units/01-installation/"
                class="mt-3 block rounded-lg bg-blue-600 px-4 py-2.5
               text-center text-sm font-semibold text-white
               hover:bg-blue-700"
            >
                Start learning
            </a>
        </div>
    </div>
</header>
