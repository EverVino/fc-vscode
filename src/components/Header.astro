---
import { siteConfig } from "../config/site";
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
    <nav
        class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 lg:px-8"
        aria-label="Main navigation"
    >
        <!-- Brand -->
        <a
            href="/"
            class="flex items-center gap-3"
            aria-label="{ siteConfig } home"
        >
            <!-- FreeCampus mark -->
            <div
                class="flex h-9 w-9 items-center justify-center rounded-lg
               bg-slate-900 text-sm font-bold text-white"
                aria-hidden="true"
            >
                FC
            </div>

            <div class="hidden sm:block">
                <span class="font-bold tracking-tight text-slate-900">
                    { siteConfig.name }
                </span>
                <span class="ml-1 text-slate-400">/</span>
                <span class="ml-1 text-slate-600">{ siteConfig.course }</span>
            </div>
        </a>

        <!-- Desktop navigation -->
        <div class="hidden items-center gap-1 md:flex">
            <a
                href="/vscode/"
                class="rounded-md px-3 py-2 text-sm font-medium
               text-slate-900 hover:bg-slate-100"
            >
                Course
            </a>

            <a
                href="/vscode/units/"
                class="rounded-md px-3 py-2 text-sm font-medium
               text-slate-600 hover:bg-slate-100 hover:text-slate-900"
            >
                Units
            </a>

            <a
                href="/vscode/about/"
                class="rounded-md px-3 py-2 text-sm font-medium
               text-slate-600 hover:bg-slate-100 hover:text-slate-900"
            >
                About
            </a>
        </div>

        <!-- Right side -->
        <div class="hidden items-center gap-3 md:flex">
            <!-- GitHub -->
            <a
                href="https://github.com/OpenScienceLabs"
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md p-2 text-slate-500
               hover:bg-slate-100 hover:text-slate-900"
                aria-label="FreeCampus on GitHub"
            >
                <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path
                        d="M12 .5C5.65.5.5 5.65.5 12c0 5.08
            3.29 9.39 7.86 10.91.57.1.78-.25.78-.55
            0-.27-.01-1.17-.02-2.13-3.2.7-3.88-1.54
            -3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68
            -1.04-.71.08-.7.08-.7 1.15.08 1.75
            1.18 1.75 1.18 1.02 1.75 2.68 1.25
            3.34.96.1-.75.4-1.25.73-1.54-2.55-.29
            -5.23-1.28-5.23-5.69 0-1.26.45-2.29
            1.18-3.1-.12-.29-.51-1.46.11-3.05
            0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1
            2.87-.39c.97 0 1.94.13 2.87.39 2.18-1.49
            3.14-1.18 3.14-1.18.62 1.59.23 2.76.11
            3.05.74.81 1.18 1.84 1.18 3.1 0 4.42
            -2.69 5.39-5.25 5.68.41.35.78 1.05.78
            2.12 0 1.53-.01 2.76-.01 3.13 0 .3.21
            .66.79.55A11.51 11.51 0 0 0 23.5 12
            C23.5 5.65 18.35.5 12 .5Z"
                    />
                </svg>
            </a>

            <!-- Start course -->
            <a
                href="/vscode/units/01-installation/"
                class="rounded-lg bg-blue-600 px-4 py-2 text-sm
               font-semibold text-white shadow-sm
               hover:bg-blue-700"
            >
                Start learning
            </a>
        </div>

        <!-- Mobile menu button -->
        <button
            type="button"
            class="rounded-md p-2 text-slate-600 hover:bg-slate-100
             hover:text-slate-900 md:hidden"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <svg
                class="h-6 w-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 6h16M4 12h16M4 18h16"
                />
            </svg>
        </button>
    </nav>

    <!-- Mobile navigation -->
    <div
        id="mobile-menu"
        class="hidden border-t border-slate-200 bg-white md:hidden"
    >
        <div class="space-y-1 px-6 py-4">
            <a
                href="/vscode/"
                class="block rounded-md px-3 py-2 text-sm font-medium
               text-slate-900 hover:bg-slate-100"
            >
                Course
            </a>

            <a
                href="/vscode/units/"
                class="block rounded-md px-3 py-2 text-sm font-medium
               text-slate-600 hover:bg-slate-100"
            >
                Units
            </a>

            <a
                href="/vscode/about/"
                class="block rounded-md px-3 py-2 text-sm font-medium
               text-slate-600 hover:bg-slate-100"
            >
                About
            </a>

            <a
                href="/vscode/units/01-installation/"
                class="mt-3 block rounded-lg bg-blue-600 px-4 py-2.5
               text-center text-sm font-semibold text-white
               hover:bg-blue-700"
            >
                Start learning
            </a>
        </div>
    </div>
</header>
