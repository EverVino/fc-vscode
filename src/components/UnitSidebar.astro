---
import type { CollectionEntry } from "astro:content";

interface Props {
  units: CollectionEntry<"units">[];
  currentUnitId: string;
}

const { units, currentUnitId } = Astro.props;

const sortedUnits = [...units].sort(
  (a, b) => a.data.unit_order - b.data.unit_order,
);

const baseUrl = import.meta.env.BASE_URL;
---

<aside class="w-full lg:w-72 lg:shrink-0">
  <nav
    aria-label="Course units"
    class="rounded-xl border border-slate-200 bg-white p-4"
  >
    <h2 class="mb-4 text-sm font-bold uppercase tracking-wide text-slate-500">
      VS Code Course
    </h2>

    <ul class="space-y-1">
      {sortedUnits.map((unit) => {
        const isCurrent = unit.id === currentUnitId;
        const href = `${baseUrl}units/${unit.id}/`;

        return (
          <li>
            <a
              href={href}
              aria-current={isCurrent ? "page" : undefined}
              class:list={[
                "block rounded-lg px-3 py-2 text-sm transition-colors",
                isCurrent
                  ? "bg-indigo-50 font-semibold text-indigo-700"
                  : "text-slate-700 hover:bg-slate-100",
              ]}
            >
              <span class="mr-2 text-xs text-slate-400">
                {String(unit.data.unit_order).padStart(2, "0")}
              </span>
              {unit.data.title}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</aside>