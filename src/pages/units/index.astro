---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const units = (await getCollection("units")).sort(
  (a, b) => a.data.unit_order - b.data.unit_order,
);
---

<BaseLayout>
  <main class="mx-auto max-w-5xl px-6 py-12">
    <h1 class="text-4xl font-bold">VS Code Units</h1>

    <p class="mt-4 text-slate-600">
      Follow these units to learn Visual Studio Code step by step.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {units.map((unit) => (
        <article class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-semibold text-indigo-600">
            Unit {unit.data.unit_order}
          </p>

          <h2 class="mt-2 text-xl font-bold">
            <a
              class="hover:text-indigo-600"
              href={`${import.meta.env.BASE_URL}units/${unit.id}/`}
            >
              {unit.data.title}
            </a>
          </h2>

          <p class="mt-3 text-slate-600">
            {unit.data.description}
          </p>

          <p class="mt-4 text-sm text-slate-500">
            {unit.data.unit_level} · {unit.data.estimated_time}
          </p>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>