---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const units = (await getCollection("units")).sort(
  (a, b) => a.data.unit_order - b.data.unit_order,
);

const baseUrl = import.meta.env.BASE_URL;

const unitUrl = (unit) =>
  `${baseUrl}/units/${unit.id.replace(/\/index$/, "")}/`;

const firstUnit = units[0];

const learningSteps = [
  {
    number: "01",
    title: "Understand",
    description: "Learn what each feature does and when to use it.",
    icon: "01",
  },
  {
    number: "02",
    title: "Explore",
    description: "Follow examples and become familiar with the interface.",
    icon: "02",
  },
  {
    number: "03",
    title: "Practice",
    description: "Complete small exercises as you learn each new skill.",
    icon: "03",
  },
  {
    number: "04",
    title: "Apply",
    description: "Use your new skills in your own projects.",
    icon: "04",
  },
];
---

<BaseLayout>
  <main class="overflow-hidden bg-white text-slate-900">
    <!-- Hero -->
    <section class="relative isolate overflow-hidden bg-slate-950 text-white">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 opacity-30"
        style="background-image: radial-gradient(#64748b 1px, transparent 1px); background-size: 24px 24px;"
      ></div>

      <div
        aria-hidden="true"
        class="pointer-events-none absolute -right-32 -top-40 -z-10 size-[28rem] rounded-full bg-blue-600/30 blur-3xl"
      ></div>

      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-48 left-1/4 -z-10 size-96 rounded-full bg-indigo-500/20 blur-3xl"
      ></div>

      <div
        class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-20 sm:px-8 lg:grid-cols-2 lg:gap-16 lg:py-28"
      >
        <div>
          <div
            class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-900/70 px-3 py-1.5 text-sm text-slate-300"
          >
            <span class="size-2 rounded-full bg-emerald-400"></span>
            Free learning · Beginner friendly
          </div>

          <h1
            class="mt-7 max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
          >
            Your journey with
            <span class="text-blue-400">VS Code</span>
            starts here.
          </h1>

          <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">
            Learn to navigate Visual Studio Code, organize your projects,
            use the terminal, and customize your workspace — one step at a time.
          </p>

          <div class="mt-9 flex flex-wrap gap-4">
            {firstUnit && (
              <a
                href={unitUrl(firstUnit)}
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-500 px-6 py-3.5 font-semibold text-white shadow-lg shadow-blue-950/30 transition hover:bg-blue-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-300"
              >
                Start learning
                <span aria-hidden="true">→</span>
              </a>
            )}

            <a
              href="#learning-path"
              class="inline-flex items-center justify-center rounded-xl border border-slate-700 bg-slate-900/60 px-6 py-3.5 font-semibold text-slate-200 transition hover:border-slate-500 hover:bg-slate-800"
            >
              Explore the course
            </a>
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-slate-400">
            <span class="inline-flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              No experience needed
            </span>
            <span class="inline-flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              Learn at your own pace
            </span>
          </div>
        </div>

        <!-- Decorative editor preview -->
        <div class="mx-auto w-full max-w-xl lg:ml-auto">
          <div
            class="overflow-hidden rounded-2xl border border-slate-700/80 bg-[#111827] shadow-2xl shadow-black/40"
          >
            <div
              class="flex items-center justify-between border-b border-slate-700/80 bg-slate-900 px-4 py-3"
            >
              <div class="flex items-center gap-2" aria-hidden="true">
                <span class="size-3 rounded-full bg-red-400"></span>
                <span class="size-3 rounded-full bg-amber-400"></span>
                <span class="size-3 rounded-full bg-emerald-400"></span>
              </div>
              <span class="text-xs text-slate-400">my-first-project</span>
              <span class="text-xs text-slate-500">VS Code</span>
            </div>

            <div class="flex min-h-64 sm:min-h-72">
              <div
                class="hidden w-12 shrink-0 flex-col items-center gap-5 border-r border-slate-700/70 bg-slate-900/70 py-5 text-slate-500 sm:flex"
                aria-hidden="true"
              >
                <span class="text-lg text-blue-400">▤</span>
                <span class="text-lg">⌕</span>
                <span class="text-lg">⑂</span>
                <span class="text-lg">▱</span>
              </div>

              <div class="min-w-0 flex-1">
                <div
                  class="flex items-center gap-2 border-b border-slate-700/70 bg-slate-900/40 px-4 py-3 text-sm"
                >
                  <span class="text-blue-400">●</span>
                  <span class="text-slate-200">hello.py</span>
                  <span class="text-slate-500">×</span>
                </div>

                <div
                  class="overflow-x-auto px-3 py-5 font-mono text-xs leading-7 sm:px-5 sm:text-sm"
                >
                  <div class="flex">
                    <span class="w-8 shrink-0 text-right text-slate-600">1</span>
                    <span class="pl-4 text-slate-500"># My first VS Code file</span>
                  </div>
                  <div class="flex">
                    <span class="w-8 shrink-0 text-right text-slate-600">2</span>
                    <span class="pl-4">
                      <span class="text-purple-300">message</span>
                      <span class="text-slate-300"> = </span>
                      <span class="text-emerald-300">"Hello, world!"</span>
                    </span>
                  </div>
                  <div class="flex">
                    <span class="w-8 shrink-0 text-right text-slate-600">3</span>
                    <span class="pl-4">
                      <span class="text-blue-300">print</span><span class="text-slate-300">(</span><span class="text-purple-300">message</span><span class="text-slate-300">)</span>
                    </span>
                  </div>
                  <div class="mt-4 border-t border-slate-700/70 pt-3">
                    <div class="flex items-center gap-2 text-xs text-slate-400">
                      <span class="text-emerald-400">●</span>
                      Ready to learn
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div
              class="flex items-center justify-between border-t border-slate-700/70 bg-slate-900 px-4 py-2 text-xs text-slate-400"
            >
              <span>main</span>
              <span>Python · UTF-8</span>
            </div>
          </div>

          <p class="mt-4 text-center text-sm text-slate-400">
            Learn the interface by working with real files and projects.
          </p>
        </div>
      </div>
    </section>

    <!-- Course highlights -->
    <section class="relative z-10 -mt-1 border-b border-slate-200 bg-white">
      <div
        class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-6 py-8 sm:px-8 md:grid-cols-4"
      >
        <div class="border-l-2 border-blue-500 pl-4">
          <p class="text-2xl font-bold tracking-tight">{units.length}</p>
          <p class="mt-1 text-sm text-slate-500">Learning units</p>
        </div>

        <div class="border-l-2 border-indigo-400 pl-4">
          <p class="text-2xl font-bold tracking-tight">Beginner</p>
          <p class="mt-1 text-sm text-slate-500">Designed for newcomers</p>
        </div>

        <div class="border-l-2 border-emerald-400 pl-4">
          <p class="text-2xl font-bold tracking-tight">Free</p>
          <p class="mt-1 text-sm text-slate-500">Open access</p>
        </div>

        <div class="border-l-2 border-amber-400 pl-4">
          <p class="text-2xl font-bold tracking-tight">Hands-on</p>
          <p class="mt-1 text-sm text-slate-500">Practice as you learn</p>
        </div>
      </div>
    </section>

    <!-- Introduction -->
    <section class="bg-slate-50">
      <div
        class="mx-auto grid max-w-7xl gap-12 px-6 py-20 sm:px-8 lg:grid-cols-2 lg:items-center lg:gap-20 lg:py-24"
      >
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-blue-600">
            A practical introduction
          </p>

          <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
            An easier way to get started with your editor.
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600">
            A new code editor can feel overwhelming at first. This course
            breaks it down into manageable lessons so you can learn what
            matters without trying to understand everything at once.
          </p>

          <a
            href="#learning-path"
            class="mt-6 inline-flex items-center gap-2 font-semibold text-blue-700 transition hover:text-blue-900"
          >
            See what you'll learn
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <div class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-lg text-blue-700" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 5.5A1.5 1.5 0 0 1 5.5 4H20v14H5.5A1.5 1.5 0 0 0 4 19.5v-14ZM4 19.5A1.5 1.5 0 0 1 5.5 18H20M8 8h8M8 11h6" />
              </svg>
            </div>
            <h3 class="mt-5 font-semibold">Clear explanations</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Understand the purpose of the features you use every day.
            </p>
          </article>

          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <div class="flex size-11 items-center justify-center rounded-xl bg-emerald-50 text-lg text-emerald-700" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </div>
            <h3 class="mt-5 font-semibold">Guided practice</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Reinforce each new concept with tasks you can complete yourself.
            </p>
          </article>

          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <div class="flex size-11 items-center justify-center rounded-xl bg-violet-50 text-lg text-violet-700" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h16M8 15l3-4 3 2 5-7" />
              </svg>
            </div>
            <h3 class="mt-5 font-semibold">Steady progress</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Build your skills in a logical order, one lesson at a time.
            </p>
          </article>

          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <div class="flex size-11 items-center justify-center rounded-xl bg-amber-50 text-lg text-amber-700" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 8 4 12l4 4m8-8 4 4-4 4m-3-12-2 16" />
              </svg>
            </div>
            <h3 class="mt-5 font-semibold">Real workflows</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Practice with files, folders, the terminal, and extensions.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:py-24">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-bold uppercase tracking-widest text-blue-600">
            Your learning approach
          </p>

          <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
            Understand it. Try it. Make it yours.
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600">
            Each lesson helps you move from understanding a feature to using
            it confidently in your own workspace.
          </p>
        </div>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {learningSteps.map((step) => (
            <article class="group rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-blue-300 hover:shadow-lg hover:shadow-blue-950/5">
              <span class="inline-flex size-11 items-center justify-center rounded-xl bg-slate-100 font-mono text-sm font-bold text-slate-600 transition group-hover:bg-blue-600 group-hover:text-white">
                {step.number}
              </span>

              <h3 class="mt-5 text-lg font-semibold">{step.title}</h3>

              <p class="mt-2 text-sm leading-6 text-slate-600">
                {step.description}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Learning path -->
    <section id="learning-path" class="scroll-mt-20 bg-slate-50">
      <div class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:py-24">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div class="max-w-2xl">
            <p class="text-sm font-bold uppercase tracking-widest text-blue-600">
              The curriculum
            </p>

            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
              Your learning path
            </h2>

            <p class="mt-4 text-lg leading-8 text-slate-600">
              Follow the units in order and build a solid foundation, from
              installation to customizing your editor.
            </p>
          </div>

          <span class="text-sm font-medium text-slate-500">
            {units.length} units to explore
          </span>
        </div>

        <div class="mt-10 grid gap-4 md:grid-cols-2">
          {units.map((unit) => (
            <a
              href={unitUrl(unit)}
              class="group flex h-full gap-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-lg hover:shadow-blue-950/5 sm:p-6"
            >
              <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 font-mono text-sm font-bold text-blue-700 transition group-hover:bg-blue-600 group-hover:text-white">
                {String(unit.data.unit_order).padStart(2, "0")}
              </span>

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-semibold text-slate-900 group-hover:text-blue-700">
                    {unit.data.title}
                  </h3>
                </div>

                <p class="mt-2 text-sm leading-6 text-slate-600">
                  {unit.data.description}
                </p>

                <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-medium text-slate-500">
                  <span>{unit.data.unit_level}</span>
                  <span aria-hidden="true">•</span>
                  <span>{unit.data.estimated_time}</span>
                </div>
              </div>

              <span class="mt-1 shrink-0 text-lg text-slate-400 transition group-hover:translate-x-1 group-hover:text-blue-600" aria-hidden="true">
                →
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Tools -->
    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:py-24">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-widest text-blue-600">
            Your toolkit
          </p>

          <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
            Skills for your everyday workflow
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600">
            Start with the editor and gradually explore the tools that help
            you work more efficiently.
          </p>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <article class="rounded-2xl border border-slate-200 p-5 transition hover:border-blue-300">
            <span class="text-sm font-bold text-blue-600">01 / EDIT</span>
            <h3 class="mt-4 font-semibold">VS Code</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Navigate your workspace and edit project files.
            </p>
          </article>

          <article class="rounded-2xl border border-slate-200 p-5 transition hover:border-blue-300">
            <span class="text-sm font-bold text-emerald-600">02 / RUN</span>
            <h3 class="mt-4 font-semibold">Terminal</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Learn to run commands directly inside your editor.
            </p>
          </article>

          <article class="rounded-2xl border border-slate-200 p-5 transition hover:border-blue-300">
            <span class="text-sm font-bold text-violet-600">03 / TRACK</span>
            <h3 class="mt-4 font-semibold">Git</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Discover version control and track project changes.
            </p>
          </article>

          <article class="rounded-2xl border border-slate-200 p-5 transition hover:border-blue-300">
            <span class="text-sm font-bold text-amber-600">04 / EXTEND</span>
            <h3 class="mt-4 font-semibold">Extensions</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Explore ways to customize your editor.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Final call to action -->
    <section class="bg-slate-950 text-white">
      <div class="mx-auto max-w-4xl px-6 py-20 text-center sm:px-8 lg:py-24">
        <span class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-900 px-3 py-1.5 text-sm text-slate-300">
          <span class="size-2 rounded-full bg-emerald-400"></span>
          Your first step starts here
        </span>

        <h2 class="mt-6 text-3xl font-bold tracking-tight sm:text-5xl">
          Ready to make VS Code work for you?
        </h2>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-300">
          Start with the fundamentals, practice as you go, and build the
          confidence to explore more on your own.
        </p>

        {firstUnit && (
          <a
            href={unitUrl(firstUnit)}
            class="mt-8 inline-flex items-center justify-center gap-2 rounded-xl bg-white px-6 py-3.5 font-semibold text-slate-950 transition hover:bg-blue-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            Start the first unit
            <span aria-hidden="true">→</span>
          </a>
        )}

        <p class="mt-5 text-sm text-slate-400">
          Free to access · Learn at your own pace
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
