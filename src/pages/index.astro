---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
	<main class="min-h-screen bg-slate-50 text-slate-900">
		<!-- Hero -->
		<section class="border-b border-slate-200 bg-white">
			<div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
				<div class="max-w-3xl">
					<p class="mb-4 text-sm font-semibold uppercase tracking-wider text-blue-600">
						Beginner-first VS Code course
					</p>

					<h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
						Learn VS Code from zero
					</h1>

					<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
						Learn how to use Visual Studio Code to write, organize,
						run, debug, and manage your projects with confidence.
					</p>

					<div class="mt-8 flex flex-wrap gap-4">
						<a
							href="/vscode/units/01-installation/"
							class="rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white
						   shadow-sm transition hover:bg-blue-700"
						>
							Start the course
						</a>

						<a
							href="#learning-path"
							class="rounded-lg border border-slate-300 bg-white px-5 py-3
						   font-semibold text-slate-700 transition hover:bg-slate-50"
						>
							View the learning path
						</a>
					</div>
				</div>

				<!-- Course statistics -->
				<div class="mt-16 grid max-w-3xl grid-cols-2 gap-6 sm:grid-cols-4">
					<div>
						<p class="text-3xl font-bold">4</p>
						<p class="mt-1 text-sm text-slate-500">Units</p>
					</div>

					<div>
						<p class="text-3xl font-bold">Beginner</p>
						<p class="mt-1 text-sm text-slate-500">Level</p>
					</div>

					<div>
						<p class="text-3xl font-bold">Free</p>
						<p class="mt-1 text-sm text-slate-500">Access</p>
					</div>

					<div>
						<p class="text-3xl font-bold">Practical</p>
						<p class="mt-1 text-sm text-slate-500">Learning</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Audience -->
		<section class="bg-slate-50">
			<div class="mx-auto max-w-6xl px-6 py-16 lg:px-8">
				<div class="grid gap-8 md:grid-cols-3">
					<!-- New to VS Code -->
					<article class="rounded-xl border border-slate-200 bg-white p-6">
						<div class="mb-5 flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
							01
						</div>

						<h2 class="text-xl font-semibold">New to VS Code?</h2>

						<p class="mt-3 leading-7 text-slate-600">
							Start from the beginning. Learn how to install VS
							Code, understand the interface, open projects, and
							work with files.
						</p>

						<a
							href="/vscode/units/01-installation/"
							class="mt-5 inline-block font-semibold text-blue-600 hover:text-blue-700"
						>
							Start with installation →
						</a>
					</article>

					<!-- Already know editors -->
					<article class="rounded-xl border border-slate-200 bg-white p-6">
						<div class="mb-5 flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
							02
						</div>

						<h2 class="text-xl font-semibold">
							Already use code editors?
						</h2>

						<p class="mt-3 leading-7 text-slate-600">
							Skip the basics and explore the features that make
							VS Code useful for everyday programming and project
							work.
						</p>

						<a
							href="#learning-path"
							class="mt-5 inline-block font-semibold text-blue-600 hover:text-blue-700"
						>
							Browse the units →
						</a>
					</article>

					<!-- Teaching -->
					<article class="rounded-xl border border-slate-200 bg-white p-6">
						<div class="mb-5 flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
							03
						</div>

						<h2 class="text-xl font-semibold">Teaching VS Code?</h2>

						<p class="mt-3 leading-7 text-slate-600">
							Use the units as a starting point for workshops,
							self-paced learning, or introductory programming
							courses.
						</p>

						<a
							href="#learning-path"
							class="mt-5 inline-block font-semibold text-blue-600 hover:text-blue-700"
						>
							Explore the course →
						</a>
					</article>
				</div>
			</div>
		</section>

		<!-- Course promise -->
		<section class="border-y border-slate-200 bg-white">
			<div class="mx-auto max-w-4xl px-6 py-16 text-center lg:py-20">
				<p class="text-sm font-semibold uppercase tracking-wider text-blue-600">
					Course promise
				</p>

				<h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
					Learn by doing, not by memorizing
				</h2>

				<p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600">
					You will learn VS Code by performing small practical tasks,
					exploring the interface, using keyboard shortcuts,
					configuring your workspace, and working with real projects.
				</p>
			</div>
		</section>

		<!-- How the course works -->
		<section>
			<div class="mx-auto max-w-6xl px-6 py-16 lg:px-8">
				<div class="max-w-2xl">
					<p class="text-sm font-semibold uppercase tracking-wider text-blue-600">
						How the course works
					</p>

					<h2 class="mt-3 text-3xl font-bold tracking-tight">
						Learn through small practical steps
					</h2>

					<p class="mt-4 text-lg leading-8 text-slate-600">
						Each unit focuses on a specific skill and gives you an
						opportunity to practice it immediately.
					</p>
				</div>

				<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					<article class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
						<span class="text-sm font-semibold text-blue-600">
							01
						</span>
						<h3 class="mt-3 font-semibold">Understand</h3>
						<p class="mt-2 text-sm leading-6 text-slate-600">
							Learn what a feature does and why it is useful.
						</p>
					</article>

					<article class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
						<span class="text-sm font-semibold text-blue-600">
							02
						</span>
						<h3 class="mt-3 font-semibold">Explore</h3>
						<p class="mt-2 text-sm leading-6 text-slate-600">
							Follow guided examples and discover the interface.
						</p>
					</article>

					<article class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
						<span class="text-sm font-semibold text-blue-600">
							03
						</span>
						<h3 class="mt-3 font-semibold">Practice</h3>
						<p class="mt-2 text-sm leading-6 text-slate-600">
							Try the feature yourself with small practical
							exercises.
						</p>
					</article>

					<article class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
						<span class="text-sm font-semibold text-blue-600">
							04
						</span>
						<h3 class="mt-3 font-semibold">Apply</h3>
						<p class="mt-2 text-sm leading-6 text-slate-600">
							Use what you learned in your own programming
							projects.
						</p>
					</article>
				</div>
			</div>
		</section>

		<!-- Learning path -->
		<section id="learning-path" class="border-y border-slate-200 bg-white">
			<div class="mx-auto max-w-6xl px-6 py-16 lg:px-8">
				<div class="max-w-2xl">
					<p class="text-sm font-semibold uppercase tracking-wider text-blue-600">
						Learning path
					</p>

					<h2 class="mt-3 text-3xl font-bold tracking-tight">
						Your path through VS Code
					</h2>

					<p class="mt-4 text-lg leading-8 text-slate-600">
						Follow the units in order or jump directly to the skills
						you need.
					</p>
				</div>

				<div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
					<a
						href="/vscode/units/01-installation/"
						class="group flex items-center gap-6 py-6 transition hover:bg-slate-50"
					>
						<span class="text-sm font-semibold text-slate-400">
							01
						</span>

						<div class="flex-1">
							<h3 class="font-semibold group-hover:text-blue-600">
								Installing VS Code
							</h3>
							<p class="mt-1 text-sm text-slate-600">
								Install VS Code and prepare your development
								environment.
							</p>
						</div>

						<span class="text-slate-400 group-hover:text-blue-600">
							→
						</span>
					</a>

					<a
						href="/vscode/units/02-interface/"
						class="group flex items-center gap-6 py-6 transition hover:bg-slate-50"
					>
						<span class="text-sm font-semibold text-slate-400">
							02
						</span>

						<div class="flex-1">
							<h3 class="font-semibold group-hover:text-blue-600">
								Understanding the Interface
							</h3>
							<p class="mt-1 text-sm text-slate-600">
								Learn the editor, explorer, command palette,
								panels, and workspace.
							</p>
						</div>

						<span class="text-slate-400 group-hover:text-blue-600">
							→
						</span>
					</a>

					<a
						href="/vscode/units/03-basic-operations/"
						class="group flex items-center gap-6 py-6 transition hover:bg-slate-50"
					>
						<span class="text-sm font-semibold text-slate-400">
							03
						</span>

						<div class="flex-1">
							<h3 class="font-semibold group-hover:text-blue-600">
								Basic Operations
							</h3>
							<p class="mt-1 text-sm text-slate-600">
								Work efficiently with files, folders, terminals,
								and keyboard shortcuts.
							</p>
						</div>

						<span class="text-slate-400 group-hover:text-blue-600">
							→
						</span>
					</a>

					<a
						href="/vscode/units/04-extensions/"
						class="group flex items-center gap-6 py-6 transition hover:bg-slate-50"
					>
						<span class="text-sm font-semibold text-slate-400">
							04
						</span>

						<div class="flex-1">
							<h3 class="font-semibold group-hover:text-blue-600">
								Extensions and Customization
							</h3>
							<p class="mt-1 text-sm text-slate-600">
								Customize VS Code and extend its capabilities
								with extensions.
							</p>
						</div>

						<span class="text-slate-400 group-hover:text-blue-600">
							→
						</span>
					</a>
				</div>
			</div>
		</section>

		<!-- Tools -->
		<section>
			<div class="mx-auto max-w-6xl px-6 py-16 lg:px-8">
				<div class="max-w-2xl">
					<p class="text-sm font-semibold uppercase tracking-wider text-blue-600">
						Tools
					</p>

					<h2 class="mt-3 text-3xl font-bold tracking-tight">
						What you will use
					</h2>

					<p class="mt-4 text-lg leading-8 text-slate-600">
						The course focuses on VS Code itself, but you will
						gradually connect it with the tools used in real
						development workflows.
					</p>
				</div>

				<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
					<div class="rounded-xl border border-slate-200 bg-white p-5">
						<h3 class="font-semibold">VS Code</h3>
						<p class="mt-2 text-sm text-slate-600">
							Your main code editor.
						</p>
					</div>

					<div class="rounded-xl border border-slate-200 bg-white p-5">
						<h3 class="font-semibold">Terminal</h3>
						<p class="mt-2 text-sm text-slate-600">
							Run commands and development tools.
						</p>
					</div>

					<div class="rounded-xl border border-slate-200 bg-white p-5">
						<h3 class="font-semibold">Git</h3>
						<p class="mt-2 text-sm text-slate-600">
							Track changes and work with repositories.
						</p>
					</div>

					<div class="rounded-xl border border-slate-200 bg-white p-5">
						<h3 class="font-semibold">Extensions</h3>
						<p class="mt-2 text-sm text-slate-600">
							Add functionality to your editor.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Final CTA -->
		<section class="bg-slate-900 text-white">
			<div class="mx-auto max-w-4xl px-6 py-16 text-center lg:py-20">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
					Ready to start using VS Code?
				</h2>

				<p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-slate-300">
					Start with the first unit and build your confidence one step
					at a time.
				</p>

				<a
					href="/vscode/units/01-installation/"
					class="mt-8 inline-block rounded-lg bg-white px-6 py-3
					   font-semibold text-slate-900 transition hover:bg-slate-100"
				>
					Start the course
				</a>
			</div>
		</section>
	</main>
</BaseLayout>
